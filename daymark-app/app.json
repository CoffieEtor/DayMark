{
  "expo": {
    "name": "DAYMARK",
    "slug": "daymark-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "daymark-app",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.svg",
    "splash": {
      "image": "./assets/splash-icon.svg",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.svg",
        "backgroundImage": "./assets/adaptive-icon-background.svg",
        "monochromeImage": "./assets/adaptive-icon-monochrome.svg"
      },
      "package": "com.expojet.daymarkapp"
    },
    "web": {
      "favicon": "./assets/favicon.svg"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.expojet.daymarkapp"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
