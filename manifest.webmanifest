{
  "name": "DAYMARK — Personal Productivity",
  "short_name": "DAYMARK",
  "description": "Personal organization system for daily responsibilities, reminders, wishlist, and decision making.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#101114",
