{
  "expo": {
    "name": "DAYMARKED",
    "slug": "daymark",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "daymarked",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "com.expojet.daymarked"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.expojet.daymarked"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0b03d8e1-d5bf-48f7-b9fe-9171763b77e3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0b03d8e1-d5bf-48f7-b9fe-9171763b77e3"
    }
  }
}
