{
  "expo": {
    "name": "DAYMARK",
    "slug": "daymark",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "daymark",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.svg",
    "splash": {
      "image": "./assets/splash-icon.svg",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.svg",
        "backgroundImage": "./assets/adaptive-icon-background.svg",
        "monochromeImage": "./assets/adaptive-icon-monochrome.svg"
      },
      "package": "com.expojet.daymark"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-splash-screen", "expo-sqlite", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.expojet.daymark"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
